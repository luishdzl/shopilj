# Variables de entorno — Natulim Style Shopify Mini Project

# Backend Python
DATABASE_URL=sqlite:///./natulim_integrations.db
REDIS_URL=redis://localhost:6379
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here  # Cambia en producción
APP_ENV=development

# Next.js Storefront
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=natulim.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_token_here

# Odoo (opcional)
ODOO_BASE_URL=https://example-odoo.com
ODOO_ACCESS_TOKEN=your_oidoo_token

# Colas (RQ)
RQ_CLIENT_ID=natulim_client